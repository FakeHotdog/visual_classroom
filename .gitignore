# 忽略 flask 目录下的所有文件和文件夹
*

!.gitignore
!README.md
!LICENSE
!requirements.txt

# 允许跟踪 WeChatProgram 整个文件夹
!WeChatProgram/
!WeChatProgram/**

# 忽略微信小程序特有的本地配置文件
WeChatProgram/project.config.json
WeChatProgram/project.private.config.json

# 允许跟踪 web-classroom 文件夹本身（才能进得去里面）
!web-classroom/

# 在 web-classroom 内部，忽略所有
web-classroom/*

# 但单独允许 web-classroom 下的 src 和 public 文件夹
!web-classroom/src/
!web-classroom/src/**
!web-classroom/public/
!web-classroom/public/**
!web-classroom/index.html
!web-classroom/app_h5.py
!web-classroom/package.json
!web-classroom/package-lock.json
!web-classroom/vite.config.js

# 允许跟踪course-review 文件夹本身（才能进得去里面）
!course-review/

# 在 course-review 内部，忽略所有
course-review/*

# 但单独允许 course-review 下的 src 文件夹
!course-review/src/
!course-review/src/**
!course-review/public/
!course-review/public/**
!course-review/index.html
!course-review/app_h5.py
!course-review/package.json
!course-review/package-lock.json
!course-review/vite.config.js