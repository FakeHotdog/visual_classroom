page {
  background: #f5f5f5;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* 聊天容器 */
.chat-container {
  flex: 1;
  padding: 20rpx;
}

.message-item {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.message-item.self {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin: 0 20rpx;
}

.message-bubble {
  max-width: 600rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  position: relative;
}

.message-item.other .message-bubble {
  background: #fff;
  border-bottom-left-radius: 8rpx;
}

.message-item.self .message-bubble {
  background: linear-gradient(135deg, #f88daa, #d95374);
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.message-content {
  font-size: 28rpx;
  line-height: 1.5;
}

.message-time {
  font-size: 20rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
  text-align: right;
}

.message-item.self .message-time {
  color: rgba(255, 255, 255, 0.8);
}

/* 底部输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  gap: 20rpx;
}

.input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx;
  background: linear-gradient(135deg, #f88daa, #d95374);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  font-size: 26rpx;
  padding: 20rpx 0;
}

.send-btn[disabled] {
  background: #ccc;
}