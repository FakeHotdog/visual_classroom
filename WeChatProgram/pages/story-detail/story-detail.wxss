page {
  background: linear-gradient(to bottom, #fff5f7, #ffeef2);
  min-height: 100vh;
}

.page {
  padding: 30rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(200, 150, 160, 0.1);
}

.author-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.author-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}

.author-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.author-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.publish-time {
  font-size: 24rpx;
  color: #999;
}

.story-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.story-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
}

.story-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
}

/* 图片列表,垂直排列，确保所有图片都显示 */
.image-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 20rpx;
}

.story-image {
  width: 100%;
  border-radius: 12rpx;
}

/* 详情页删除按钮 */
.delete-btn {
  background: #ff4d4f;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  margin-left: auto;
}