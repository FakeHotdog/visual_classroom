page {
  background: linear-gradient(to bottom, #fff5f7, #ffeef2);
  min-height: 100rpx;
  padding-bottom: 60rpx;
}
.page {
  padding: 40rpx 30rpx;
}

/* 头像区域 */
.avatar-wrap {
  text-align: center;
  margin-bottom: 50rpx;
}
.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #eee;
  border: 4rpx solid #f88daa; /* 粉色边框，贴合主题 */
}
.tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 通用表单项 */
.item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(200,150,160,0.1);
}
/* 必填项标记 */
.required .required-tag {
  color: #d95374;
  font-size: 24rpx;
  margin-left: 8rpx;
}
/* 标签样式 */
.label {
  font-size: 28rpx;
  color: #333;
  width: 160rpx; /* 固定标签宽度，布局更整齐 */
}
/* 输入框样式 */
.input {
  font-size: 28rpx;
  text-align: right;
  flex: 1;
  color: #666;
}
/* 选择器样式 */
.picker-val {
  font-size: 28rpx;
  color: #666;
  flex: 1;
  text-align: right;
}
/* 短文本域（个性签名） */
.textarea {
  flex-direction: column;
  align-items: flex-start;
}
.textarea textarea {
  width: 100%;
  height: 80rpx;
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 0;
}
/* 生日文本样式 */
.val {
  font-size: 28rpx;
  color: #666;
  flex: 1;
  text-align: right;
}

/* 保存按钮（底部固定） */
.save-btn {
  position: fixed;
  bottom: 30rpx;
  left: 30rpx;
  right: 30rpx;
  background: linear-gradient(135deg, #f88daa, #d95374);
  color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(217, 83, 116, 0.3);
}