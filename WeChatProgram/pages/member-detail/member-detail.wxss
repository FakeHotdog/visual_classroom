page {
  background: linear-gradient(to bottom, #fff5f7, #ffeef2);
  min-height: 100vh;
}

.page {
  padding: 30rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(200, 150, 160, 0.1);
}

/* 顶部个人信息 */
.profile-header {
  display: flex;
  align-items: center;
  gap: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  margin-bottom: 30rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}

.profile-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.identity {
  font-size: 26rpx;
  color: #d95374;
}

/* 信息列表 */
.info-list {
  display: flex;
  flex-direction: column;
  gap: 25rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.label {
  font-size: 26rpx;
  color: #999;
  width: 120rpx;
  flex-shrink: 0;
}

.value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  text-align: right;
  line-height: 1.5;
}

.empty-info {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}